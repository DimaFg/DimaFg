# Скопируйте в .env и заполните. Файл .env не коммитится.
ENVIRONMENT=local                 # local | staging | production
SITE_ADDRESS=localhost            # домен для Caddy (TLS выпускается автоматически)
SITE_URL=https://localhost

POSTGRES_USER=photo
POSTGRES_PASSWORD=                # обязательно
POSTGRES_DB=photo
APP_SECRET=                       # обязательно, например: openssl rand -hex 32

MEDIA_PUBLIC_BASE_URL=https://cdn.example.com
PRIVACY_POLICY_VERSION=2026-10-draft

# Открытые решения ТЗ (раздел 22) — реальные контакты
CONTACT_EMAIL=mail@mail.ru
TELEGRAM_HANDLE=experement0
TELEGRAM_CHANNEL=your_channel
PHOTOGRAPHER_NAME=Дмитрий
SERVICE_AREA=Москва и область
COPYRIGHT_YEAR=2026

# Политика конфиденциальности (/privacy). PRIVACY_APPROVED=1 убирает плашку «Черновик» —
# ставьте только после проверки текста юристом.
PRIVACY_OPERATOR=
LEAD_RETENTION=
HOSTING_PROVIDER=
PRIVACY_APPROVED=

# Уведомления о заявках. Без них worker пишет обезличенную запись в лог.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# Повторы уведомлений (outbox)
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_SECONDS=30
OUTBOX_RETRY_MAX_SECONDS=3600
OUTBOX_LOCK_TIMEOUT_SECONDS=600
